{
  "manifest_version": 3,
  "name": "GHL Message Suggestions",
  "version": "1.0.0",
  "description": "Suggest and paste outreach messages into the GoHighLevel composer.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://app.gohighlevel.com/*",
        "https://*.gohighlevel.com/*",
        "https://*.msgsndr.com/*"
      ],
      "js": ["scripts/message-suggestions.js"],
      "run_at": "document_idle"
    }
  ]
}
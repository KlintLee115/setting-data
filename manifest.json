{
  "manifest_version": 3,
  "name": "GHL Setting Tracker",
  "version": "1.0.0",
  "description": "Track GoHighLevel calls and lead names, with message suggestions.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://app.gohighlevel.com/*",
        "https://*.gohighlevel.com/*",
        "https://*.msgsndr.com/*"
      ],
      "js": ["scripts/message-suggestions.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["tracker/index.html"],
      "matches": [
        "https://app.gohighlevel.com/*",
        "https://*.gohighlevel.com/*",
        "https://*.msgsndr.com/*"
      ]
    }
  ]
}